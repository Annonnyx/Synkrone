DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
PLATFORM_SECRET_KEY=please-generate-a-64-char-random-string
# Volume root for every service. Use ./.data when running from source.
PLATFORM_DATA_DIR=/data
# Docker: /var/run/docker.sock — rootless Podman: /run/user/$UID/podman/podman.sock
DOCKER_SOCKET=/var/run/docker.sock
RUNTIME_IMAGE_MODE=public        # or "registry"
RUNTIME_REGISTRY=registry.example.com/platform
SFTP_HOST=sftp.example.com
SFTP_PORT=2022

# Public URL of this panel (no trailing slash). Used as OAuth redirect origin.
# Local: http://127.0.0.1:3668/hebergement
# Prod : https://synkrone.app/hebergement
# Launched from the Synkrone root, the site proxies this under /hebergement.
SYNKRONE_PANEL_ORIGIN=http://127.0.0.1:3668/hebergement
# ORBITAL_PUBLIC_ORIGIN=http://127.0.0.1:3668/hebergement

# Default site hostname suffix: {service-slug}.{SYNKRONE_PUBLIC_DOMAIN}
SYNKRONE_PUBLIC_DOMAIN=example.com
# ORBITAL_PUBLIC_DOMAIN=example.com
SYNKRONE_PUBLIC_HOST=
SYNKRONE_PUBLIC_IP=
SYNKRONE_PUBLIC_IPV6=
# Optional: directory Traefik file provider watches (default docker/proxy/dynamic).
# ORBITAL_TRAEFIK_DYNAMIC_DIR=

# OAuth — leave empty to hide the provider on the login screen.
# Redirect URIs to register on each provider console:
#   {SYNKRONE_PANEL_ORIGIN}/api/auth/oauth/github/callback
#   {SYNKRONE_PANEL_ORIGIN}/api/auth/oauth/google/callback
#   {SYNKRONE_PANEL_ORIGIN}/api/auth/oauth/discord/callback
# Discord OAuth here is user login (identify + email), not a bot token.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Root of the Synkrone git repo (bots/synkrone/py, templates/discord).
# Optional when the panel is started from dashboard/Orbital-hebergeur.
SYNKRONE_REPO_ROOT=
