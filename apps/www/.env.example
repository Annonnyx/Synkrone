# Copier vers .env (déjà gitignoré).
PORT=3668
# 127.0.0.1 = cet ordinateur (recommandé). 0.0.0.0 = réseau local, HTTP, à éviter avec de vraies clés.
SYNKRONE_LISTEN_HOST=127.0.0.1
SESSION_SECRET=change-me-local

# URL publique du site (sans slash final). Obligatoire derrière un reverse proxy HTTPS.
# PUBLIC_ORIGIN=https://synkrone.app

# Si apps/ui/.env et apps/sharing/.env n'existent pas, renseigner ici :
PASSWORD=dev
MDP=dev
# En production, /ui /sharing /hub sont fermés. SYNKRONE_INTERNAL=1 pour les rouvrir.
# SYNKRONE_INTERNAL=0

# Vide = templates/discord (fichiers du dépôt, pas une base distante)
DATA_DIR=

# Discord OAuth — optionnel. Sans ces clés le site se parcourt, le login Discord redirige vers l'accueil.
# Enregistrer LES DEUX URIs sur le même application Discord (identify + email) :
#   {PUBLIC_ORIGIN}/auth/discord/callback
#   {PUBLIC_ORIGIN}/hebergement/api/auth/oauth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://127.0.0.1:3668/auth/discord/callback
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_SUPPORT_INVITE_URL=
DISCORD_TICKET_CATEGORY_ID=
DISCORD_SUPPORT_ROLE_ID=
ROULETTE_DEV_MODE=false

# Panel d'hébergement — lancé automatiquement (proxy /hebergement)
# En prod : SYNKRONE_PANEL_ORIGIN=https://synkrone.app/hebergement
# SYNKRONE_PANEL_ORIGIN=http://127.0.0.1:3668/hebergement
# SYNKRONE_SKIP_PANEL=1
# SYNKRONE_PANEL_PORT=3000

# Vente de packs Krônes (identité vendeur — obligatoire en production)
# SYNKRONE_SELLER_NAME=Synkrone
# SYNKRONE_SELLER_LEGAL_FORM=
# SYNKRONE_SELLER_ADDRESS=
# SYNKRONE_SELLER_SIRET=
# SYNKRONE_SELLER_VAT_NUMBER=
# SYNKRONE_SELLER_EMAIL=
# SYNKRONE_SELLER_RCS=
# SYNKRONE_SELLER_IBAN=
# SYNKRONE_SELLER_BIC=
# SYNKRONE_MEDIATOR_NAME=
# SYNKRONE_MEDIATOR_URL=
# SYNKRONE_VAT_RATE=0.20
# SYNKRONE_PAY_PROVIDER=pending
# Ne jamais mettre SYNKRONE_PAY_DEMO=1 en production (crédite sans payer).
# SYNKRONE_PAY_DEMO=1
# SYNKRONE_PAY_WEBHOOK_SECRET=

# GitHub / Google
# Discord et Google : une appli, plusieurs redirect URIs.
# GitHub : une callback par appli. Deux applis → GITHUB_* (site) + GITHUB_PANEL_* (panel).
#   Site  : {PUBLIC_ORIGIN}/auth/github/callback
#           {PUBLIC_ORIGIN}/auth/google/callback
#   Panel : {PUBLIC_ORIGIN}/hebergement/api/auth/oauth/github/callback
#           {PUBLIC_ORIGIN}/hebergement/api/auth/oauth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://127.0.0.1:3668/auth/github/callback
GITHUB_PANEL_CLIENT_ID=
GITHUB_PANEL_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3668/auth/google/callback
